# Docker Compose ortam değişkenleri.
# Sunucuda: cp .env.example .env  ve aşağıdaki değerleri doldurun.
# Bu dosya SADECE Docker içindir; yerelde Herd ile çalışırken Qr_menu/.env kullanılır.

# Zorunlu. Üretmek için: cd Qr_menu && php artisan key:generate --show
# (base64:... ile başlayan tüm değeri kopyalayın)
APP_KEY=

APP_NAME=QR Menu
APP_ENV=production
APP_DEBUG=false

# Backend'in dışarıdan görünen adresi
APP_URL=https://api.senindomainin.com

# --- Veritabanı ---
DB_DATABASE=qr_menu
DB_USERNAME=root
# Zorunlu. Hem MySQL root şifresi hem de Laravel'in bağlantı şifresidir.
DB_PASSWORD=

# --- Personel Hesapları (StaffSeeder bunlardan oluşturur) ---
# Zorunlu. Varsayılan admin123 / 123456 değerlerini canlıda ASLA kullanmayın.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CASHIER_USERNAME=kasa
CASHIER_PASSWORD=

# --- Frontend (derleme anında gömülür, değişince --build şart) ---
VITE_API_URL=https://api.senindomainin.com
# https://api.imgbb.com adresinden alınır. Boşsa görsel yüklenemez.
# Not: bu değer derlenmiş JS içinde herkese görünür.
VITE_IMGBB_API_KEY=
